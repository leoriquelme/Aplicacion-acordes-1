rules_version = '2';
// Reglas de permisos del Cancionero.
// Se entra con Iglesia + Nombre. Perfiles: admin (Administrador), director (Director musical),
// colaborador (Colaborador). Administrador y Director necesitan contraseña.
//
// churches/{iglesia}               { name, adminKey, adminPassword? (antes adminPin), accessCode?, ownerUid?, ownerEmail?, ownerName?, city?, status?, createdAt? }
//   ← el id es el nombre "normalizado" (sin mayúsculas, tildes ni espacios de más), así no hay dos iglesias con el mismo nombre.
//     Las antiguas las creó el administrador a mano; las nuevas las crea cualquiera con cuenta de Google (queda como Administrador).
//     status: 'activa' (o sin campo) | 'bloqueada' (la bloquea el Super Admin: nadie puede entrar)
// owners/{uid} { churches: [ids] }  ← iglesias creadas por cada cuenta de Google (máximo 3)
// superadmins/{uid}  ← lo crea Leonardo a mano en la consola: quien está aquí ve y administra todas las iglesias
// churches/{iglesia}/people/{nombre} { name, role, firstSeen, lastSeen }  ← quienes han entrado
// churches/{iglesia}/private/pins  { pins: { nombre: "1234" } }  ← contraseñas de directores (nadie lo lee)
// churches/{iglesia}/sessions/{uid} { key, name, role, pin }  ← cada equipo que entró
// churches/{iglesia}/participations/{evento__persona} { eventId, personKey, name, role, group, date }
// churches/{iglesia}/favorites/{persona} { songs: [ids], notes: { cancion: [notas] } }  ← solo la propia persona
// churches/{iglesia}/suggestions/{id} { text, songId, songTitle, personKey, name, at }  ← solo el admin lee
// stats/oracion { count }  ← contador de oraciones por el proyecto
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function churchPath(c) { return /databases/$(database)/documents/churches/$(c); }
    function sessionPath(c) { return /databases/$(database)/documents/churches/$(c)/sessions/$(request.auth.uid); }
    function personPath(c, key) { return /databases/$(database)/documents/churches/$(c)/people/$(key); }
    function pinsPath(c) { return /databases/$(database)/documents/churches/$(c)/private/pins; }

    function church(c) { return get(churchPath(c)).data; }
    // Super Admin: su cuenta de Google está en superadmins/{uid} (se crea a mano en la consola).
    function isSuper() { return signedIn() && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid)); }
    // Entró con una cuenta de Google (correo verificado).
    function googleUser() {
      return signedIn() && request.auth.token.email_verified == true
        && 'google.com' in request.auth.token.firebase.identities;
    }
    // Igual que keyOf() en la app: "Iglesia  Bautista Ñuñoa" → "iglesia bautista nunoa".
    function norm(n) {
      // (lower() no cambia letras con tilde, por eso se reemplazan también las mayúsculas)
      return n
        .replace('[áàâäãåÁÀÂÄÃÅ]', 'a').replace('[éèêëÉÈÊË]', 'e').replace('[íìîïÍÌÎÏ]', 'i')
        .replace('[óòôöõÓÒÔÖÕ]', 'o').replace('[úùûüÚÙÛÜ]', 'u').replace('[ñÑ]', 'n').replace('[çÇ]', 'c')
        .lower().replace('[^a-z0-9]+', ' ').trim();
    }
    // Contraseña del Administrador: campo adminPassword (antes se llamaba adminPin; se aceptan los dos
    // mientras se cambia el nombre en la consola; si existen ambos, vale adminPassword).
    function adminPass(c) { return church(c).get('adminPassword', church(c).get('adminPin', null)); }
    function activa(c) { return church(c).get('status', 'activa') != 'bloqueada'; }
    function isOwner(c) { return signedIn() && church(c).get('ownerUid', '') == request.auth.uid; }
    // Contraseña (antes PIN) de al menos 8 caracteres: letras, números o símbolos.
    function longPin(p) { return string(p).size() >= 8; }
    // Un nombre "común": no es el del administrador ni el de un director.
    function plainName(c, key) {
      return key != church(c).adminKey
        && (!exists(personPath(c, key)) || get(personPath(c, key)).data.role == 'colaborador');
    }
    // ¿La sesión sigue siendo válida? Se revisa en cada lectura y escritura, así que si cambia
    // la contraseña, el perfil o el código de acceso, las sesiones viejas dejan de servir al instante.
    function sessionOk(c, s) {
      return activa(c) && sessionRoleOk(c, s);
    }
    // Administrador: con su contraseña, o con la cuenta de Google dueña de la iglesia.
    // Director: con su contraseña, o con la cuenta de Google que vinculó.
    function sessionRoleOk(c, s) {
      return (s.role == 'colaborador'
          && (!('accessCode' in church(c)) || s.get('code', '') == church(c).accessCode)
          && plainName(c, s.key))
        || (s.role == 'admin' && s.key == church(c).adminKey
          && ((s.get('pin', '') == adminPass(c) && longPin(adminPass(c)))
              || isOwner(c)))
        || (s.role == 'director' && exists(personPath(c, s.key))
          && get(personPath(c, s.key)).data.role == 'director'
          && (get(personPath(c, s.key)).data.get('uid', '') == request.auth.uid
              || (s.get('pin', '') == get(pinsPath(c)).data.get('pins', {}).get(s.key, null) && longPin(s.get('pin', '')))));
    }

    function isMember(c) { return signedIn() && exists(sessionPath(c)) && sessionOk(c, sess(c)); }
    function sess(c) { return get(sessionPath(c)).data; }
    function isAdmin(c) { return isMember(c) && sess(c).role == 'admin'; }
    function isDirector(c) { return isMember(c) && sess(c).role == 'director'; }
    function canEdit(c) { return isAdmin(c) || isDirector(c); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 60; }
    function shortText(t, max) { return t is string && t.size() <= max; }

    // Entrar: colaborador con un nombre común (y el código, si la iglesia tiene);
    // director o administrador solo con su contraseña. Un nombre de director o administrador
    // no puede entrar como colaborador (así nadie ve las notas de otro).
    function validSession(c, uid) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == uid && exists(churchPath(c))
        && d.key is string && validName(d.key) && validName(d.name)
        && sessionOk(c, d);
    }

    // Biblioteca compartida entre iglesias: cada iglesia comparte voluntariamente sus canciones
    // (confirmando que tiene permiso). Todos los que entraron pueden buscar y copiar.
    // library/{iglesia__cancion} { churchId, churchName, songId, title, author, key, content, order, sharedBy, confirmed }
    function validShare(pid, d) {
      return canEdit(d.churchId)
        && pid == d.churchId + '__' + d.songId
        && d.confirmed == true
        && d.keys().hasOnly(['churchId', 'churchName', 'songId', 'title', 'author', 'key', 'content', 'order', 'sharedBy', 'confirmed', 'sharedAt'])
        && validName(d.title) && d.content is string && d.content.size() < 20000
        && shortText(d.get('churchName', ''), 60) && shortText(d.get('sharedBy', ''), 60)
        && shortText(d.get('author', ''), 120) && (!('order' in d) || (d.order is list && d.order.size() <= 60));
    }
    match /library/{pid} {
      allow read: if signedIn();
      allow create, update: if validShare(pid, request.resource.data);
      allow delete: if canEdit(resource.data.churchId) || isSuper();
    }

    // Iglesias donde un Director vinculó su cuenta de Google (solo un índice para mostrárselas;
    // entrar igual lo revisan las reglas de la sesión).
    match /links/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if googleUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['churches'])
        && request.resource.data.churches is map && request.resource.data.churches.size() <= 20;
    }

    match /superadmins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Cuántas iglesias creó cada cuenta de Google (máximo 3, para que no se llene de iglesias vacías).
    match /owners/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isSuper();
      allow create: if googleUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['churches'])
        && request.resource.data.churches is list && request.resource.data.churches.size() == 1;
      allow update: if googleUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['churches'])
        && request.resource.data.churches is list
        && request.resource.data.churches.size() == resource.data.churches.size() + 1
        && request.resource.data.churches.size() <= 3
        && request.resource.data.churches.hasAll(resource.data.churches)
        // El Super Admin, al borrar una iglesia, la saca de la lista (así esa cuenta puede crear otra).
        || (isSuper() && request.resource.data.keys().hasOnly(['churches'])
          && request.resource.data.churches is list && resource.data.churches.hasAll(request.resource.data.churches));
      allow delete: if false;
    }

    // Crear una iglesia nueva (con cuenta de Google). Como el id es el nombre normalizado, si ya existe
    // una con el mismo nombre la creación falla, aunque dos personas lo intenten al mismo tiempo.
    function validNewChurch(c) {
      let d = request.resource.data;
      let owners = /databases/$(database)/documents/owners/$(request.auth.uid);
      return googleUser()
        && d.keys().hasOnly(['name', 'city', 'adminKey', 'ownerUid', 'ownerEmail', 'ownerName', 'status', 'createdAt'])
        && validName(d.name) && c.size() >= 3 && c.size() <= 60 && c == norm(d.name)
        && d.ownerUid == request.auth.uid && d.ownerEmail == request.auth.token.email
        && validName(d.ownerName) && d.adminKey == norm(d.ownerName) && d.adminKey.size() > 0
        && d.status == 'activa' && d.createdAt == request.time
        && shortText(d.get('city', ''), 60)
        // Debe anotarse en owners/{uid} en el mismo envío (así se cuentan las iglesias de cada cuenta).
        && existsAfter(owners) && c in getAfter(owners).data.churches
        && !(exists(owners) && c in get(owners).data.churches);
    }

    // Super Admin: ve y borra todo lo de cualquier iglesia (para limpiar iglesias de prueba o vacías).
    match /churches/{c}/{rest=**} {
      allow read, delete: if isSuper();
    }

    // Contador de oraciones por el proyecto: cualquiera que entró suma de a uno.
    match /stats/oracion {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /churches/{c} {
      allow get: if isAdmin(c) || isSuper() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      // Cada cuenta de Google puede buscar las iglesias que creó; el Super Admin, todas.
      allow list: if isSuper() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if validNewChurch(c);
      allow delete: if false; // el Super Admin borra (ver arriba)
      // El administrador cambia (o quita) el código de acceso, o vincula su cuenta de Google.
      // El Super Admin solo bloquea o desbloquea.
      allow update: if (isAdmin(c)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessCode', 'ownerUid', 'ownerEmail'])
        && (!('accessCode' in request.resource.data)
            || (request.resource.data.accessCode is string && request.resource.data.accessCode.size() >= 4 && request.resource.data.accessCode.size() <= 12))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'ownerEmail'])
            || (googleUser() && request.resource.data.ownerUid == request.auth.uid
                && request.resource.data.ownerEmail == request.auth.token.email)))
        || (isSuper()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['activa', 'bloqueada']);

      match /sessions/{uid} {
        allow create, update: if validSession(c, uid);
        allow read, delete: if signedIn() && request.auth.uid == uid;
      }

      match /people/{key} {
        allow read: if isMember(c);
        // Al entrar por primera vez uno queda registrado como colaborador (con su propio nombre).
        allow create: if isMember(c) && key == sess(c).key && request.resource.data.role == 'colaborador'
          && validName(request.resource.data.name)
          || isAdmin(c);
        // Cada uno actualiza su "última vez"; el administrador cambia perfiles.
        allow update: if isAdmin(c)
          || (isMember(c) && key == sess(c).key
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'name', 'teams', 'uid'])
              && validName(request.resource.data.name)
              // Un Director vincula su cuenta de Google (desde una sesión abierta con su contraseña).
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
                  || (googleUser() && sess(c).role == 'director' && request.resource.data.uid == request.auth.uid))
              && (!('teams' in request.resource.data) || (request.resource.data.teams is list && request.resource.data.teams.size() <= 12)));
        allow delete: if isAdmin(c);
      }

      match /private/{doc} {
        allow read: if false;
        allow write: if isAdmin(c);
      }

      match /songs/{song} {
        allow read: if isMember(c);
        allow create, update: if canEdit(c)
          && (!('content' in request.resource.data) || shortText(request.resource.data.content, 50000));
        allow delete: if isAdmin(c);
      }

      match /events/{event} {
        allow read: if isMember(c);
        allow create, update, delete: if canEdit(c);
      }

      // Inscripción para servir en un evento: un registro por persona y evento ("evento__persona").
      // Cada uno se inscribe o se quita a sí mismo; Administrador y Director pueden hacerlo por otros.
      match /participations/{pid} {
        allow read: if isMember(c);
        allow create, update: if isMember(c)
          && request.resource.data.eventId is string
          && exists(/databases/$(database)/documents/churches/$(c)/events/$(request.resource.data.eventId))
          && pid == request.resource.data.eventId + '__' + request.resource.data.personKey
          && validName(request.resource.data.name)
          && request.resource.data.role is string && request.resource.data.role.size() <= 40
          && request.resource.data.keys().hasOnly(['eventId', 'personKey', 'name', 'role', 'group', 'date', 'at', 'prueba'])
          && shortText(request.resource.data.get('group', ''), 40) && shortText(request.resource.data.get('date', ''), 10)
          && (canEdit(c) || request.resource.data.personKey == sess(c).key);
        allow delete: if canEdit(c) || (isMember(c) && resource.data.personKey == sess(c).key);
      }

      // Favoritas de cada persona: solo ella las ve y las cambia.
      match /favorites/{key} {
        allow read, delete: if isMember(c) && key == sess(c).key;
        allow create, update: if isMember(c) && key == sess(c).key
          && request.resource.data.keys().hasOnly(['songs', 'notes'])
          && (!('songs' in request.resource.data) || (request.resource.data.songs is list && request.resource.data.songs.size() <= 500))
          && (!('notes' in request.resource.data) || (request.resource.data.notes is map && request.resource.data.notes.size() <= 500));
      }

      // Sugerencias de mejoras: cualquiera que entró envía; solo el Administrador las lee y resuelve.
      match /suggestions/{sid} {
        allow read, delete: if isAdmin(c);
        allow create: if isMember(c)
          && request.resource.data.keys().hasOnly(['text', 'songId', 'songTitle', 'personKey', 'name', 'at'])
          && request.resource.data.personKey == sess(c).key
          && request.resource.data.name == sess(c).name
          && shortText(request.resource.data.songId, 100)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.songTitle is string && request.resource.data.songTitle.size() <= 120;
        allow update: if false;
      }
    }
  }
}
